{
    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI", "MjcMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
        }

        def Material "PhysicsMaterial_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI", "MjcMaterialAPI"]
        )
        {
            uniform double mjc:rollingfriction = 0.01
            uniform double mjc:torsionalfriction = 0.01
            float newton:rollingFriction = 0.01
            float newton:torsionalFriction = 0.01
            float physics:dynamicFriction = 1.3
        }

        def MjcActuator "FL_hip"
        {
            uniform double mjc:ctrlRange:max = 120
            uniform double mjc:ctrlRange:min = -120
            rel mjc:target = </a2_description/Geometry/base/FL_hip/FL_hip_joint>
        }

        def MjcActuator "FL_thigh"
