                            custom rel physics:body1
                            prepend rel physics:body1 = </a2_description/Geometry/base/RR_hip/RR_thigh/RR_calf>
                            point3f physics:localPos0 = (0, 0, -0.275)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (1, 0, 0, 0)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                            float physics:lowerLimit = -158.7093
                            float physics:upperLimit = -30.93972
                        }
                    }

                    def PhysicsRevoluteJoint "RR_thigh_joint" (
                        prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    )
                    {
                        uniform token physics:axis = "Y"
                        custom rel physics:body0
                        prepend rel physics:body0 = </a2_description/Geometry/base/RR_hip>
                        custom rel physics:body1
                        prepend rel physics:body1 = </a2_description/Geometry/base/RR_hip/RR_thigh>
                        point3f physics:localPos0 = (0, -0.12779, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                        float physics:lowerLimit = -89.38142
                        float physics:upperLimit = 225.74538
                    }
                }

                def PhysicsRevoluteJoint "RR_hip_joint" (
                    prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                )
                {
                    uniform token physics:axis = "X"
                    custom rel physics:body0
                    prepend rel physics:body0 = </a2_description/Geometry/base>
                    custom rel physics:body1
                    prepend rel physics:body1 = </a2_description/Geometry/base/RR_hip>
                    point3f physics:localPos0 = (-0.25944, -0.075113, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                    float physics:lowerLimit = -57.868736
                    float physics:upperLimit = 57.868736
                }
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
        }

        over "PhysicsMaterial_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.01
            float newton:torsionalFriction = 0.01
            float physics:dynamicFriction = 1.3
        }
    }
}

