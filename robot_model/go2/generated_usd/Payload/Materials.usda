                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </go2_description/Materials/white>
            }

            over "base_4" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </go2_description/Materials/gray>
            }

            over "Box" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </go2_description/Materials/gray>
            }

            over "FL_hip"
            {
