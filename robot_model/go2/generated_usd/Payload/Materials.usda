                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </go2_description/Materials/metal>
                }

                over "hip_1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </go2_description/Materials/gray>
                }

                over "FL_thigh"
                {
                    over "thigh_0" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </go2_description/Materials/metal>
