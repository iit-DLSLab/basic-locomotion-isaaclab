        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
        }

        def MjcActuator "FL_hip"
        {
            uniform double mjc:ctrlRange:max = 120
            uniform double mjc:ctrlRange:min = -120
            rel mjc:target = </pegasus_description/Geometry/base/FL_hip/FL_hip_joint>
        }

